{
  "name": "sourcebook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Save LinkedIn recruiters and job descriptions from your browser.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:ff": "wxt -b firefox",
    "build": "wxt build",
    "build:ff": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wxt": "0.21.3"
  }
}
