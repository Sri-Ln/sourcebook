# Dependencies
node_modules/

# WXT build output
.output/
.wxt/
dist/
*.zip

# Environment
.env
.env.*
!.env.example

# Test fixtures — see docs/superpowers/specs for the full policy.
#
# Raw captured LinkedIn HTML contains real people's names, headlines, and photo
# URLs. Those people never agreed to appear in a public repository, so raw
# captures stay local and are never committed. Use them for development and for
# diagnosing what moved after a LinkedIn redesign.
#
# Scrubbed fixtures — same markup structure, every human detail replaced with
# placeholders — live in tests/fixtures/scrubbed/ and ARE committed, so CI can
# run extractor tests against realistic markup.
# Ignore the contents, not the directory. Excluding `raw/` outright means git
# never descends into it, and a negation for .gitkeep would silently do nothing.
tests/fixtures/raw/*
!tests/fixtures/raw/.gitkeep

# Implementation plans stay local. Specs are committed because they record why
# decisions were made, which nothing else captures. Plans are execution
# scaffolding, and the GitHub issues already are the plan — a committed copy
# would drift into a second, stale source of truth within a week.
docs/superpowers/plans/

# Exported job descriptions, in case an export ever lands in the working tree
*.export.md
exports/

# Transient git worktrees created for parallel agent work. They contain a full
# checkout, so leaving them untracked would offer the whole tree for commit.
.claude/worktrees/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
